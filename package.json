{
  "name": "yanye",
  "productName": "砚页",
  "version": "0.9.0",
  "author": "YanYe Team",
  "license": "MIT",
  "description": "砚页 YanYe，面向 Windows 的本地文档、表格、白板与演示工作区",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "tauri dev",
    "build": "pnpm typecheck && vite build",
    "start": "tauri dev",
    "package:win": "tauri build --no-bundle && node scripts/package-win.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:desktop": "node test/tauri-desktop.mjs",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@kayahr/text-encoding": "2.2.2",
    "@lezer/highlight": "1.2.5",
    "@tauri-apps/api": "2.12.5",
    "@tiptap/core": "3.35.0",
    "@tiptap/extension-code-block": "3.35.0",
    "@tiptap/extension-image": "3.35.0",
    "@tiptap/extension-placeholder": "3.35.0",
    "@tiptap/extension-table": "3.35.0",
    "@tiptap/extension-task-item": "3.35.0",
    "@tiptap/extension-task-list": "3.35.0",
    "@tiptap/markdown": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "@tiptap/react": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "@tiptap/suggestion": "3.35.0",
    "cfb": "1.2.2",
    "dompurify": "3.5.0",
    "exceljs": "4.4.0",
    "flowchart.js": "1.18.1",
    "jszip": "3.10.1",
    "katex": "0.19.1",
    "lowlight": "3.3.0",
    "lucide-react": "1.79.0",
    "marked": "17.0.6",
    "mermaid": "12.3.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "pptxgenjs": "4.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "saxes": "5.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "playwright": "1.65.1",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
